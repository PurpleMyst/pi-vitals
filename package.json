{
  "name": "pi-vitals",
  "version": "1.2.2",
  "description": "A powerline-style footer for pi",
  "type": "module",
  "main": "dist/extension.js",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=esm --minify --legal-comments=eof --outfile=dist/extension.js --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-ai --external:@earendil-works/pi-agent-core --external:@earendil-works/pi-tui --external:typebox",
    "build:debug": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=esm --sourcemap --outfile=dist/extension.js --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-ai --external:@earendil-works/pi-agent-core --external:@earendil-works/pi-tui --external:typebox",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist/",
    "src/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcowger/pi-vitals.git"
  },
  "bugs": {
    "url": "https://github.com/mcowger/pi-vitals/issues"
  },
  "homepage": "https://github.com/mcowger/pi-vitals#readme",
  "keywords": [
    "pi",
    "extension",
    "footer",
    "powerline",
    "pi-package",
    "pi-coding-agent"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "author": "Matt Cowger",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@earendil-works/pi-tui": "^0.79.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@earendil-works/pi-tui": "^0.79.0",
    "@types/node": "^25.9.2",
    "esbuild": "^0.27.0",
    "lefthook": "^1.13.6",
    "typescript": "^6.0.3"
  }
}
